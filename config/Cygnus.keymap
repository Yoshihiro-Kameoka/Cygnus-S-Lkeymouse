#define ZMK_POINTING_DEFAULT_SCRL_VAL 240    // default: 10; encoder scroll amount per notch

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer indices (definition order)

#define WIN_BASE    0
#define MAC_BASE    1
#define NUM         2
#define SYMBOL      3
#define WIN_MOUSE   4
#define MAC_MOUSE   5
#define WIN_SCROLL  6
#define MAC_SCROLL  7
#define BLE         8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // BT_SEL 0 = Windows → win_base

        BT_WIN: BT_WIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on WIN_BASE>;

            label = "BT_WIN";
        };

        // BT_SEL 1 = Mac → mac_base

        BT_MAC1: BT_MAC1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on MAC_BASE>;

            label = "BT_MAC1";
        };

        // BT_SEL 2 = Mac → mac_base（同じ Mac レイヤー）

        BT_MAC2: BT_MAC2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>,
                <&tog_on MAC_BASE>;

            label = "BT_MAC2";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: Windows base

        win_base {
            bindings = <
&kp Q             &kp W         &kp E         &kp R               &kp T                                                              &kp Y             &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F               &kp G                &mkp RCLK                      &lt BLE CARET  &kp H             &kp J  &kp K      &kp L    &lt WIN_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V               &kp B                &mkp LCLK                      &kp RS(COLON)  &kp N             &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt NUM LANGUAGE_2  &lt WIN_MOUSE SPACE  &lt WIN_SCROLL LANGUAGE_1      &kp BACKSPACE  &lt SYMBOL ENTER                             &kp DEL
            >;

            sensor-bindings =
                <&encoder_msc_down_up>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // 1: Mac base（修飾・右下 Shift は Win と共通。Space/Scroll の飛び先だけ Mac）

        mac_base {
            bindings = <
&kp Q             &kp W             &kp E         &kp R               &kp T                                                              &kp Y             &kp U  &kp I      &kp O    &kp P
&kp A             &kp S             &kp D         &kp F               &kp G                &mkp RCLK                      &lt BLE CARET  &kp H             &kp J  &kp K      &kp L    &lt MAC_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V               &kp B                &mkp LCLK                      &kp RS(COLON)  &kp N             &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LEFT_GUI      &kp LEFT_CONTROL  &kp LEFT_ALT  &lt NUM LANGUAGE_2  &lt MAC_MOUSE SPACE  &lt MAC_SCROLL LANGUAGE_1      &kp BACKSPACE  &lt SYMBOL ENTER                             &kp DEL
            >;

            sensor-bindings =
                <&encoder_msc_down_up>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // 2: NUM（OS 共用）

        num {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                            &kp SLASH     &kp EQUAL     &kp ASTERISK  &kp PLUS      &kp PERCENT
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans      &trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &trans      &trans  &kp F11       &kp F12       &kp COMMA     &kp DOT       &kp DOLLAR
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans                                                  &kp PIPE
            >;
        };

        // 3: SYMBOL（OS 共用）

        symbol {
            bindings = <
&kp QUESTION  &kp EXCLAMATION  &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                   &kp SLASH              &kp EQUAL          &kp ASTERISK     &kp PLUS          &kp PERCENT
&kp HASH      &kp GRAVE        &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &trans         &kp CARET  &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW     &kp RIGHT_ARROW   &kp UNDER
&kp AT_SIGN   &kp LESS_THAN    &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp COLON      &kp SEMI   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp DOLLAR
&trans        &trans           &trans             &trans            &trans                &trans         &trans     &trans                                                                       &trans
            >;
        };

        // 4: Windows mouse（ユーザー定義 L1）

        win_mouse {
            bindings = <
&kp ESC         &trans          &kp UP_ARROW    &trans     &kp LS(LG(S))                      &kp RS(RG(LEFT_ARROW))  &trans    &kp RG(TAB)     &trans    &kp RS(RG(RIGHT_ARROW))
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans         &trans      &trans  &mkp MB4                &mkp MB1  &mo WIN_SCROLL  &mkp MB2  &mkp MB5
&kp LEFT_SHIFT  &kp LC(X)       &kp LC(C)       &kp LC(V)  &kp LC(B)      &trans      &trans  &kp HOME                &trans    &trans          &trans    &kp END
&trans          &trans          &trans          &trans     &trans         &trans      &trans  &trans                                                      &trans
            >;
        };

        // 5: Mac mouse（同じ配置。修飾を Gui/Mac 相当へ）

        mac_mouse {
            bindings = <
&kp ESC         &trans          &kp UP_ARROW    &trans     &kp LG(LC(LS(NUMBER_4)))                      &kp LC(LEFT_ARROW)  &trans    &kp RC(UP_ARROW)  &trans    &kp LC(RIGHT_ARROW)
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans                    &trans      &trans  &mkp MB4            &mkp MB1  &mo MAC_SCROLL    &mkp MB2  &mkp MB5
&kp LEFT_SHIFT  &kp LG(X)       &kp LG(C)       &kp LG(V)  &kp LG(B)                 &trans      &trans  &kp HOME            &trans    &trans            &trans    &kp END
&trans          &trans          &trans          &trans     &trans                    &trans      &trans  &trans                                                    &trans
            >;
        };

        // 6: Windows scroll（キーは win_mouse と同内容。ボールだけホイール化）

        win_scroll {
            bindings = <
&kp ESC         &trans          &kp UP_ARROW    &trans     &kp LS(LG(S))                      &kp RS(RG(LEFT_ARROW))  &trans    &kp RG(TAB)  &trans    &kp RS(RG(RIGHT_ARROW))
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans         &trans      &trans  &mkp MB4                &mkp MB1  &trans       &mkp MB2  &mkp MB5
&kp LEFT_SHIFT  &kp LC(X)       &kp LC(C)       &kp LC(V)  &kp LC(B)      &trans      &trans  &kp HOME                &trans    &trans       &trans    &kp END
&trans          &trans          &trans          &trans     &trans         &trans      &trans  &trans                                                   &trans
            >;
        };

        // 7: Mac scroll（キーは mac_mouse と同内容。ボールだけホイール化）

        mac_scroll {
            bindings = <
&kp ESC         &trans          &kp UP_ARROW    &trans     &kp LG(LC(LS(NUMBER_4)))                      &kp LC(LEFT_ARROW)  &trans    &kp RC(UP_ARROW)  &trans    &kp LC(RIGHT_ARROW)
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans                    &trans      &trans  &mkp MB4            &mkp MB1  &trans            &mkp MB2  &mkp MB5
&kp LEFT_SHIFT  &kp LG(X)       &kp LG(C)       &kp LG(V)  &kp LG(B)                 &trans      &trans  &kp HOME            &trans    &trans            &trans    &kp END
&trans          &trans          &trans          &trans     &trans                    &trans      &trans  &trans                                                    &trans
            >;
        };

        // 8: BLE / システム（BT0=Win, BT1/BT2=Mac）

        ble {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &BT_WIN  &BT_MAC1  &BT_MAC2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans   &trans    &trans    &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans   &trans    &trans    &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                     &bt BT_CLR_ALL
            >;
        };
    };
};
